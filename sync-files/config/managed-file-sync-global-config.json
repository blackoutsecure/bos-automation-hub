{
  "managed_file_sync": {
    "take_over_managed_files": true,
    "cleanup_duplicate_lines": true,
    "managed_files_path": "sync-files",
    "services": [
      "shellcheck",
      "yamllint",
      "coverage_artifacts",
      "bos_universal_security_kicker",
      "bos_universal_sync_kicker"
    ],
    "file_patches": [
      {
        "service": "common",
        "path": ".gitignore",
        "remove": [
          ".vscode/*",
          "!.vscode/extensions.json"
        ],
        "append": [
          ".vscode/"
        ]
      }
    ],
    "service_definitions": {
      "bos_universal_security_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-security-kicker.yml",
            "content_file": "workflows/bos-universal-security-kicker.yml"
          }
        ]
      },
      "bos_universal_sync_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-sync-kicker.yml",
            "content_file": "workflows/bos-universal-sync-kicker.yml"
          }
        ]
      },
      "bos_universal_action_test_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-action-test-kicker.yml",
            "content_file": "workflows/bos-universal-action-test-kicker.yml"
          }
        ]
      },
      "bos_universal_marketplace_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-marketplace-kicker.yml",
            "content_file": "workflows/bos-universal-marketplace-kicker.yml"
          }
        ]
      },
      "bos_universal_upstream_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-upstream-kicker.yml",
            "content_file": "workflows/bos-universal-upstream-kicker.yml"
          }
        ]
      },
      "bos_universal_gatekeeper_kicker": {
        "mode": "file",
        "description": "Central gatekeeper kicker. Also removes the superseded bos-universal-launchpad-kicker.yml so a renamed consumer never ends up running both front doors.",
        "files": [
          {
            "path": ".github/workflows/bos-universal-gatekeeper-kicker.yml",
            "content_file": "workflows/bos-universal-gatekeeper-kicker.yml"
          },
          {
            "path": ".github/workflows/bos-universal-launchpad-kicker.yml",
            "mode": "absent"
          }
        ]
      },
      "org_defaults": {
        "mode": "file",
        "description": "Organization-wide community health, pull request, issue, funding, and profile defaults for blackoutsecure/.github.",
        "files": [
          {
            "path": "CODE_OF_CONDUCT.md",
            "content_file": "community-health/CODE_OF_CONDUCT.md"
          },
          {
            "path": "CONTRIBUTING.md",
            "content_file": "community-health/CONTRIBUTING.md"
          },
          {
            "path": "SECURITY.md",
            "content_file": "community-health/SECURITY.md"
          },
          {
            "path": "SUPPORT.md",
            "content_file": "community-health/SUPPORT.md"
          },
          {
            "path": "FUNDING.yml",
            "content_file": "community-health/FUNDING.yml"
          },
          {
            "path": ".github/PULL_REQUEST_TEMPLATE.md",
            "content_file": "github-meta/PULL_REQUEST_TEMPLATE.md"
          },
          {
            "path": ".github/ISSUE_TEMPLATE/bug_report.md",
            "content_file": "github-meta/ISSUE_TEMPLATE/bug_report.md"
          },
          {
            "path": ".github/ISSUE_TEMPLATE/config.yml",
            "content_file": "github-meta/ISSUE_TEMPLATE/config.yml"
          },
          {
            "path": ".github/ISSUE_TEMPLATE/feature_request.md",
            "content_file": "github-meta/ISSUE_TEMPLATE/feature_request.md"
          },
          {
            "path": "profile/README.md",
            "content_file": "org-profile/README.md"
          }
        ]
      }
    }
  }
}
