{
  "organization": {
    "runners": {
      "default": "ubuntu-latest",
      "x64": "ubuntu-latest",
      "arm64": "ubuntu-24.04-arm"
    },
    "reporting": {
      "enable_job_summary": true,
      "enable_annotations": true,
      "title_prefix": "Blackout Secure",
      "fail_on": "fail"
    },
    "defaults": {
      "timeout_minutes": 30
    }
  },
  "launchpad": {
    "repo_metadata": {
      "enable": true,
      "homepage": "https://github.com/blackoutsecure/bos-automation-hub",
      "ai_model": "auto",
      "description_mode": "auto",
      "description_fallback": "",
      "use_existing_readme": true,
      "generate_readme": false,
      "generate_topics": true,
      "topics_fallback": "github-actions automation reusable-workflows composite-actions devops ci-cd workflow-automation"
    }
  },
  "gate": {
    "node_lint_mode": "auto",
    "python_lint_mode": "auto",
    "shell_lint_mode": "auto"
  },
  "action_pins": {
    "_comment": [
      "First-party Blackout Secure actions whose hub pins are kept current",
      "automatically by .github/workflows/sync-action-pins.yml.",
      "",
      "Pins stay as immutable commit SHAs so PS012 (require_pinned_actions),",
      "Marketplace SC002 hygiene, and CodeQL actions/unpinned-tag all stay",
      "satisfied. The bumper resolves the newest tag - ranking stable releases",
      "and pre-releases together by SemVer - and rewrites the SHA plus its",
      "trailing '# <tag>' comment, then opens a PR for review.",
      "",
      "channel: auto   -> newest version wins, pre-release or not (default)",
      "channel: stable -> ignore pre-releases entirely"
    ],
    "channel": "auto",
    "scan_globs": [
      ".github/workflows/*.yml",
      ".github/actions/**/action.yml",
      "sync-files/workflows/*.yml"
    ],
    "repositories": [
      { "repository": "blackoutsecure/bos-code-scanning-kit" },
      { "repository": "blackoutsecure/bos-managed-file-sync-action" },
      { "repository": "blackoutsecure/bos-marketplace-kit" },
      { "repository": "blackoutsecure/bos-workflow-gatekeeper" },
      { "repository": "blackoutsecure/bos-repo-about-sync-action" },
      { "repository": "blackoutsecure/bos-upstream-watcher" },
      { "repository": "blackoutsecure/bos-sitemap-generator" },
      { "repository": "blackoutsecure/bos-securitytxt-generator" },
      { "repository": "blackoutsecure/bos-robotstxt-generator" },
      { "repository": "blackoutsecure/bos-web-application-manifest-generator" }
    ]
  },
  "remediation": {
    "mode": "notify",
    "min_confidence": "high",
    "allow_workflow_changes": false,
    "allow_security_control_changes": false,
    "allow_auto_merge": false
  }
}
