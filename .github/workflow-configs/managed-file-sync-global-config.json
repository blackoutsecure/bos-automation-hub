{
  "managed_file_sync": {
    "take_over_managed_files": true,
    "managed_files_path": "sync-files/sync-files/workflows",
    "services": [
      "shellcheck",
      "bos_universal_security_kicker",
      "bos_universal_sync_kicker"
    ],
    "service_definitions": {
      "bos_universal_security_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-security-kicker.yml",
            "content_file": "bos-universal-security-kicker.yml"
          }
        ]
      },
      "bos_universal_sync_kicker": {
        "mode": "file",
        "files": [
          {
            "path": ".github/workflows/bos-universal-sync-kicker.yml",
            "content_file": "bos-universal-sync-kicker.yml"
          }
        ]
      }
    }
  }
}