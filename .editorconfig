# Managed by Blackout Secure. Best practices applied via marketplace config, customized in sync-files/config/managed-file-sync-global-config.json and .github/bos-universal-config.json.
# Starter template, safe to customize. This file is only ever created, never overwritten.
root = true





# >>> managed-file-sync:editorconfig >>>
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
# <<< managed-file-sync:editorconfig <<<
